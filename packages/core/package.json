{
  "name": "dom-blame",
  "version": "1.0.0",
  "description": "Zero-config full-stack runtime lineage inspector (DOM <- Component Prop <- HTTP JSON <- SQL) and payload overfetch auditor.",
  "license": "MIT",
  "author": "Muhammad Wahaj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwahaj36/dom-blame.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mwahaj36/dom-blame#readme",
  "bugs": {
    "url": "https://github.com/mwahaj36/dom-blame/issues"
  },
  "keywords": ["react", "devtools", "debugging", "schema-drift", "overfetch", "sql", "mcp"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./iife": "./dist/dom-blame.iife.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
