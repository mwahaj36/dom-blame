{
  "name": "@dom-blame/server",
  "version": "1.0.0",
  "description": "Backend AsyncLocalStorage middleware and SQL query correlator for dom-blame.",
  "license": "MIT",
  "author": "Muhammad Wahaj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwahaj36/dom-blame.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/mwahaj36/dom-blame#readme",
  "bugs": {
    "url": "https://github.com/mwahaj36/dom-blame/issues"
  },
  "keywords": ["dom-blame", "express", "nextjs", "sqlite", "postgres", "prisma", "sql-tracing"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "express": "^5.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
